{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/cli/**/*.ts",
    "src/core/**/*.ts",
    "src/sources/**/*.ts",
    "src/parsers/**/*.ts",
    "src/detectors/**/*.ts",
    "src/diagnosis/**/*.ts",
    "src/evaluation/**/*.ts",
    "src/policy/**/*.ts",
    "src/review/**/*.ts",
    "src/reporters/**/*.ts",
    "src/trend/**/*.ts"
  ],
  "exclude": [
    "src/app/**",
    "src/components/**",
    "node_modules"
  ]
}
